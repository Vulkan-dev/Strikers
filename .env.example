# ==============================================================================
# STR Clan Portal - Discord Bot & Guild Environment Configuration
# Add these in Vercel Project Settings -> Environment Variables
# ==============================================================================

# Discord Bot Token from Discord Developer Portal
# Permissions needed: Manage Channels, Send Messages, Embed Links
DISCORD_BOT_TOKEN=your_bot_token_here

# Your Discord Server (Guild) ID
DISCORD_GUILD_ID=your_guild_id_here

# The Category ID where applicant review channels should be created
DISCORD_CATEGORY_ID=your_category_id_here

# Optional: Staff Role ID to mention/tag when new channel is opened
DISCORD_STAFF_ROLE_ID=your_staff_role_id_here

# Optional: Fallback webhook URL (already built-in as default)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
